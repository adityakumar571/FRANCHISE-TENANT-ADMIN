# Relative URL — Vite proxy forwards /api/* to local backend (port 9001)
# This avoids CORS issues in local development entirely
VITE_API_BASE_URL=/api/

VITE_GOOGLE_MAPS_API_KEY=AIzaSyAQqh6qd0umyH9zAmfsfbVHuMvFcN_m3kQ

# School LMS — subdomain pattern for dev
VITE_SCHOOL_BASE_URL=http://{subdomain}.localhost:5179

# School portal direct URL (fallback when no subdomain routing)
VITE_SCHOOL_PORTAL_URL=http://localhost:5179

# Default Tenant ID for development (use your tenant's subdomain)
# This should be set per franchise. Example: register, taha, demo, etc.
VITE_TENANT_ID=register

# Supplier Portal URL (for direct login feature)
# This should point to FRANCHISE-ADMIN-FRONTEND which runs on port 5179
VITE_SUPPLIER_PORTAL_URL=http://localhost:5179